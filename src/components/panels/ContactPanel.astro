---
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<article
  class="v2-panel"
  id="v2-panel-contact"
  data-panel="contact"
  role="tabpanel"
  aria-labelledby="v2-tab-contact"
>
  <h2 class="v2-h1">{t.contact.title}</h2>
  <p class="v2-prose">{t.contact.intro}</p>

  <div class="v2-contact-grid">
    <a
      class="v2-contact-card is-primary"
      href="mailto:sdavidleonardo01@gmail.com"
    >
      <div class="v2-contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
      </div>
      <div class="v2-contact-body">
        <span class="v2-contact-label">Email</span>
        <span class="v2-contact-value">sdavidleonardo01@gmail.com</span>
      </div>
      <svg class="v2-contact-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>

    <a
      class="v2-contact-card"
      href="https://www.linkedin.com/in/david-leonardo-sepúlveda-chávez-21303a255"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="v2-contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v15H.22zM8.59 8h4.37v2.05h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.48 3.04 5.48 7v8.31h-4.56v-7.37c0-1.76-.03-4.03-2.45-4.03-2.45 0-2.83 1.92-2.83 3.9V23H8.59z"
          ></path>
        </svg>
      </div>
      <div class="v2-contact-body">
        <span class="v2-contact-label">LinkedIn</span>
        <span class="v2-contact-value">david-leonardo-sepúlveda</span>
      </div>
      <svg class="v2-contact-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </a>

    <a
      class="v2-contact-card"
      href="https://github.com/DavidSepulvedaCh"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="v2-contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 .5C5.73.5.75 5.48.75 11.75c0 4.99 3.23 9.21 7.71 10.7.56.1.77-.24.77-.54v-1.9c-3.13.68-3.79-1.51-3.79-1.51-.51-1.31-1.25-1.66-1.25-1.66-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.43.11-2.97 0 0 .94-.3 3.09 1.16a10.74 10.74 0 0 1 5.62 0c2.15-1.46 3.09-1.16 3.09-1.16.61 1.54.23 2.68.11 2.97.72.79 1.16 1.8 1.16 3.03 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.09c0 .3.21.65.78.54 4.48-1.49 7.7-5.71 7.7-10.7C23.25 5.48 18.27.5 12 .5z"
          ></path>
        </svg>
      </div>
      <div class="v2-contact-body">
        <span class="v2-contact-label">GitHub</span>
        <span class="v2-contact-value">@DavidSepulvedaCh</span>
      </div>
      <svg class="v2-contact-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7"></path>
        <path d="M7 7h10v10"></path>
      </svg>
    </a>
  </div>

  <ul class="v2-contact-tags">
    <li class="v2-contact-tag">
      <span class="v2-contact-dot" aria-hidden="true"></span>
      {t.contact.available}
    </li>
    <li class="v2-contact-tag">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      {t.contact.timezone}
    </li>
    <li class="v2-contact-tag">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="7" width="18" height="13" rx="2"></rect>
        <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
      </svg>
      {t.contact.modality}
    </li>
  </ul>
</article>
