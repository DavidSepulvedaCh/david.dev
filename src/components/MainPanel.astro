---
import TopBar from "@/components/TopBar.astro";
import AboutPanel from "@/components/panels/AboutPanel.astro";
import ResumePanel from "@/components/panels/ResumePanel.astro";
import ProjectsPanel from "@/components/panels/ProjectsPanel.astro";
import ContactPanel from "@/components/panels/ContactPanel.astro";
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="v2-main" aria-label={t.a11y.main}>
  <TopBar lang={lang} />

  <div class="v2-panels">
    <AboutPanel lang={lang} />
    <ResumePanel lang={lang} />
    <ProjectsPanel lang={lang} />
    <ContactPanel lang={lang} />
  </div>
</section>
